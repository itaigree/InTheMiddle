// Security rules for the app's Google Firestore (shared results, see
// site/js/providers/share-store.js and README, "שיתוף התוצאות"). Pasted into
// the Firebase console: Firestore Database → Rules → Publish.
//
// Anyone may read one share by its id (the link holds it), and create one, once,
// with exactly the fields the app writes. Nothing can be listed, changed or
// deleted (the TTL policy on expireAt deletes them).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if id.matches('^[A-Za-z0-9_-]{12}$')
        && request.resource.data.keys().hasOnly(['v', 'data', 'expireAt'])
        && request.resource.data.keys().hasAll(['v', 'data', 'expireAt'])
        && request.resource.data.v is int
        && request.resource.data.v == 1
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 65536
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt < request.time + duration.value(31, 'd');
      allow update, delete: if false;
    }
    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
